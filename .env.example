PORT=3004
GATEWAY_URL=http://127.0.0.1:18789
GATEWAY_TOKEN=change-me
ALLOWED_EMAIL=carvalhojose321@gmail.com
JWT_SECRET=change-me
WORKSPACE_ROOT=C:\\Users\\seuca\\.openclaw\\workspace

# Auth:
# - totp (default): use /login with email+TOTP
# - cloudflare: trust Cloudflare Access header (Cf-Access-Authenticated-User-Email)
# - none: disable auth (ONLY if fully protected upstream)
AUTH_MODE=cloudflare

# Runs:
WIP_LIMIT=2
DEFAULT_MODEL=kimi-coding/k2p5

# Frontend (Vite) — set to 1 if auth is handled upstream (Cloudflare Access)
VITE_AUTH_DISABLED=1

# Minimum validated summary length to allow run status=done
MIN_DONE_SUMMARY_CHARS=120
